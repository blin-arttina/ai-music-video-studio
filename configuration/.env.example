SECRET_KEY=change-me
DATABASE_URL=sqlite:///studio.db
# No sign-in system: anyone with this app's address can use it, all as the
# same local "creator" account (these two are optional overrides).
# DEFAULT_OWNER_EMAIL=creator@music-video-studio.local
# DEFAULT_OWNER_NAME=Creator
DEFAULT_WATERMARK_TEXT=
# Optional AI provider keys (leave unset to keep those modules in 'not connected' mode)
ANTHROPIC_API_KEY=
AI_MUSIC_PROVIDER_API_KEY=
AI_IMAGE_PROVIDER_API_KEY=
AI_VIDEO_PROVIDER_API_KEY=
AI_TEXT_PROVIDER_API_KEY=
# AI Voice needs no key -- it's self-hosted (Chatterbox). Just
# `pip install -r requirements-voice.txt` on this server. These two are
# optional overrides (defaults shown) -- see requirements-voice.txt.
# CHATTERBOX_DEVICE=cpu
# CHATTERBOX_NANO=true
